# Postgres connection string for local dev / self-hosted deploy.
# Local dev example: postgresql://postgres:devpassword@localhost:5434/opportunities
DATABASE_URL=

# GitHub fine-grained, read-only, expiring Personal Access Token.
# Required for server-side authenticated raw content fetches (never fetch
# unauthenticated in production - see research/PITFALLS.md Pitfall 1).
GITHUB_PAT=

# Shared secret required in the Authorization: Bearer header to trigger
# POST /api/sync manually. Generate a random string (e.g. openssl rand -hex 32).
SYNC_TRIGGER_SECRET=
