# Postgres connection string for local dev / self-hosted deploy.
# Local dev example: postgresql://postgres:devpassword@localhost:5434/opportunities
DATABASE_URL=

# GitHub fine-grained, read-only, expiring Personal Access Token.
# Required for server-side authenticated raw content fetches (never fetch
# unauthenticated in production - see research/PITFALLS.md Pitfall 1).
GITHUB_PAT=

# Shared secret required in the Authorization: Bearer header to trigger
# POST /api/sync manually. Generate a random string (e.g. openssl rand -hex 32).
SYNC_TRIGGER_SECRET=


# Shared secret required in the Authorization: Bearer header for the
# external Claude Code auto-apply session to call back
# POST /api/applications/[externalId]/apply-session. Separate from
# SYNC_TRIGGER_SECRET, never reuse it. Generate a random string (e.g.
# openssl rand -hex 32).
AUTO_APPLY_CALLBACK_SECRET=

# Real base URL of the deployed app (e.g. https://opportunities.juan-tech.com),
# no trailing slash. Used by generateApplyPrompt (Phase 7 "Send to AI") to
# build a copy-paste-ready curl command for the callback above. Optional: if
# omitted, the prompt derives the base URL from the incoming request's
# x-forwarded-host/host headers instead (best-effort).
NEXT_PUBLIC_APP_URL=